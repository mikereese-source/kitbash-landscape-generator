+def _patch(rng, scale, level):
+    """A lava drip patch (V1, the Lava Beds roof): a glaze mass on the roof (pivot on the roof, 1 across for a
+    medium patch), its top set a little in, a scalloped edge, the underside sagging into heavy lobes where the
+    glaze ran (Mike: large patches, clear volumes; a thin sheet read as a badge on the roof), and stubby
+    teeth (6-15% of the patch long, 1-3x as long as wide) hanging from the lowest points of the lobes. Teeth
+    stay well inside the edge (near it they floated off the scallops), their roots inside the glaze; each
+    piece whole, all quads."""
+    sheet_grid, tooth_grid, teeth = PATCH_GRID[level]
+    off = Vector((rng.uniform(-50, 50), rng.uniform(-50, 50), rng.uniform(-50, 50)))
+    wide = rng.uniform(0.6, 1.0)  # across the other way
+    thick, sunk = 0.06, 0.03
+    lobe = lambda a: 1.0 + 0.2 * noise.noise(Vector((math.cos(a) * 1.5, math.sin(a) * 1.5, 0.0)) + off) + 0.1 * noise.noise(Vector((math.cos(a) * 5.0, math.sin(a) * 5.0, 0.0)) + off)
+    sag = lambda q: 1.0 + 2.2 * max(noise.noise(q * 2.5 + off), 0.0) ** 1.3  # the hanging lobes, 1 to about 3x deep
+
+    def underside(x, y):
+        """The glaze's underside height at a point inside the patch, and how deep the lobe is there."""
+        edge = lobe(math.atan2(y / wide, x)) * 0.5
+        qx, qy = x / edge, y / (edge * wide)
+        q = Vector((qx, qy, -math.sqrt(max(1.0 - qx * qx - qy * qy, 0.0))))
+        return q.z * thick * sag(q), sag(q)
+
+    bm = bmesh.new()
+    bmesh.ops.create_cube(bm, size=2.0)
+    bmesh.ops.subdivide_edges(bm, edges=bm.edges[:], cuts=sheet_grid - 1, use_grid_fill=True)
+    for v in bm.verts:
+        q = v.co.normalized()
+        edge = lobe(math.atan2(q.y, q.x)) * 0.5
+        v.co = Vector((q.x * edge, q.y * edge * wide, q.z * sunk if q.z > 0.0 else q.z * thick * sag(q)))
+    spots = []
+    for _ in range(teeth * 6):  # candidates; the teeth take the deepest lobes
+        a, f = rng.uniform(0.0, 2.0 * math.pi), math.sqrt(rng.random()) * 0.7
+        x, y = math.cos(a) * f * lobe(a) * 0.5, math.sin(a) * f * lobe(a) * 0.5 * wide
+        z, depth = underside(x, y)
+        spots.append((depth + rng.uniform(0.0, 0.6), x, y, z))
+    for _depth, x, y, z in sorted(spots, reverse=True)[:teeth]:
+        tooth = _piece("Lava Drips", rng, rng.uniform(0.06, 0.15), tooth_grid)
+        tooth.verts.index_update()
+        verts = [bm.verts.new(t.co + Vector((x, y, z * 0.85))) for t in tooth.verts]
+        for face in tooth.faces:
+            bm.faces.new([verts[t.index] for t in face.verts])
+        tooth.free()
+    for v in bm.verts:
+        v.co *= scale
+    return bm
+
